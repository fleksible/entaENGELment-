{
  "permissions": {
    "deny": [
      "Edit(/data/receipts/**)",
      "Edit(/receipts/**)"
    ],
    "ask": [
      "Edit(/index/**)",
      "Edit(/policies/**)",
      "Edit(/spec/**)",
      "Edit(/seeds/**)",
      "Edit(/VOIDMAP.yml)",
      "Edit(/VOIDMAP.yaml)",
      "Edit(/docs/negations.md)",
      "Edit(/NICHTRAUM/archive/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/intake_shadow_copy.py",
            "async": true
          }
        ]
      }
    ]
  }
}
